{{!-- views/home.hbs --}}

<!-- Hero Section / Banner principal -->
<section class="hero-section bg-dark text-white py-5 position-relative overflow-hidden border-bottom border-warning border-3">
  <div class="container py-lg-5">
    <div class="row align-items-center gy-4">
      <div class="col-lg-6">
        <span class="badge bg-warning text-dark fs-6 mb-3 fw-bold">100% Artesanal a la Leña</span>
        <h1 class="display-3 fw-bold mb-3">La verdadera pizza napolitana en tu mesa</h1>
        <p class="lead text-light opacity-75 mb-4">
          Masa madre de fermentación lenta, ingredientes frescos de primera calidad y el toque único de nuestro horno de piedra.
        </p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/productos" class="btn btn-warning btn-lg fw-bold text-dark px-4">Ver Menú</a>
          <a href="/promos" class="btn btn-outline-light btn-lg px-4">Promociones</a>
        </div>
      </div>
      <div class="col-lg-6 text-center">
        <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=800&q=80" alt="Pizza Napolitana Recién Horneada" class="img-fluid rounded-4 shadow-lg border border-secondary">
      </div>
    </div>
  </div>
</section>

<!-- Sección de Destacados / Razones -->
<section class="py-5 bg-black text-white">
  <div class="container">
    <div class="row text-center gy-4">
      <div class="col-md-4">
        <div class="p-4 bg-dark rounded-3 h-100 border border-secondary">
          <i class="bi bi-fire fs-1 text-warning mb-3 d-block"></i>
          <h3 class="h5 fw-bold">Horno a la Leña</h3>
          <p class="text-secondary small mb-0">Horneadas a más de 450°C para lograr el auténtico borde alvéolo y crujiente.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 bg-dark rounded-3 h-100 border border-secondary">
          <i class="bi bi-award-fill fs-1 text-warning mb-3 d-block"></i>
          <h3 class="h5 fw-bold">Ingredientes Top</h3>
          <p class="text-secondary small mb-0">Mozzarella fior di latte, salsa de tomates San Marzano y albahaca fresca.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 bg-dark rounded-3 h-100 border border-secondary">
          <i class="bi bi-truck fs-1 text-warning mb-3 d-block"></i>
          <h3 class="h5 fw-bold">Delivery Rápido</h3>
          <p class="text-secondary small mb-0">Enviamos tu pizza en cajas térmicas especiales para que llegue caliente como recién salida del horno.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sección de Pizzas Más Vendidas (Inyectadas estáticamente) -->
<section id="promos" class="py-5 bg-dark text-white">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-warning">Nuestras Favoritas</h2>
      <p class="text-secondary">Las pizzas más elegidas por nuestros clientes esta semana</p>
    </div>

    <div class="row gy-4">
      <!-- Pizza 1 -->
      <div class="col-lg-4 col-md-6">
        <div class="card bg-black text-white h-100 border-secondary shadow-sm">
          <img src="https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Margherita Especial" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Margherita Especial</h3>
              <span class="badge bg-warning text-dark fs-6">$4.500</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Salsa San Marzano, fior di latte, albahaca fresca y aceite de oliva virgen extra.
            </p>
            <a href="/productos/1" class="btn btn-outline-warning w-100 mt-3">Pedir Ahora</a>
          </div>
        </div>
      </div>

      <!-- Pizza 2 -->
      <div class="col-lg-4 col-md-6">
        <div class="card bg-black text-white h-100 border-secondary shadow-sm">
          <img src="https://images.unsplash.com/photo-1628840042765-356cda07504e?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Pepperoni Supreme" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Pepperoni Supreme</h3>
              <span class="badge bg-warning text-dark fs-6">$5.200</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Doble pepperoni picante, queso mozzarella fundido y un toque de orégano silvestre.
            </p>
            <a href="/productos/2" class="btn btn-outline-warning w-100 mt-3">Pedir Ahora</a>
          </div>
        </div>
      </div>

      <!-- Pizza 3 -->
      <div class="col-lg-4 col-md-6">
        <div class="card bg-black text-white h-100 border-secondary shadow-sm">
          <img src="https://images.unsplash.com/photo-1573821663912-569905455b1c?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Cuatro Quesos" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Cuatro Quesos</h3>
              <span class="badge bg-warning text-dark fs-6">$5.600</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Mezcla cremosa de Mozzarella, gorgonzola, provolone estacionado y láminas de parmesano.
            </p>
            <a href="/productos/3" class="btn btn-outline-warning w-100 mt-3">Pedir Ahora</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action / Pedido rápido -->
<section class="py-5 bg-warning text-dark text-center">
  <div class="container py-3">
    <h2 class="fw-bold mb-3">¿Tenés hambre? No esperes más</h2>
    <p class="fs-5 mb-4">Hacé tu pedido online en menos de 2 minutos o conocé nuestro local.</p>
    <a href="/productos" class="btn btn-dark btn-lg fw-bold px-5">Ver Todo el Menú</a>
  </div>
</section>
  
