{{!-- views/productos.hbs --}}

<!-- Header de la sección -->
<section class="bg-dark text-white py-5 border-bottom border-warning border-3">
  <div class="container text-center">
    <h1 class="display-4 fw-bold text-warning">Nuestro Menú</h1>
    <p class="lead text-secondary mb-0">Descubrí nuestras pizzas artesanales, empanadas, postres y bebidas.</p>
  </div>
</section>

<!-- Sección Principal de Productos -->
<section class="py-5 bg-black text-white min-vh-100">
  <div class="container">
    
    <!-- Barra de Búsqueda y Filtros de Categoría -->
    <div class="row mb-5 gy-3 align-items-center">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-dark border-secondary text-warning">
            <i class="bi bi-search"></i>
          </span>
          <input type="text" id="buscarProducto" class="form-control bg-dark text-white border-secondary" placeholder="Buscar pizza, ingrediente...">
        </div>
      </div>
      <div class="col-md-6">
        <div class="d-flex gap-2 overflow-auto pb-2 pb-md-0 justify-md-content-end">
          <button class="btn btn-warning fw-bold px-3 text-nowrap" data-filter="todos">Todos</button>
          <button class="btn btn-outline-warning text-nowrap" data-filter="pizzas">Pizzas</button>
          <button class="btn btn-outline-warning text-nowrap" data-filter="empanadas">Empanadas</button>
          <button class="btn btn-outline-warning text-nowrap" data-filter="postres">Postres</button>
          <button class="btn btn-outline-warning text-nowrap" data-filter="bebidas">Bebidas</button>
        </div>
      </div>
    </div>

    <!-- Grid de Productos -->
    <div class="row gy-4">

      <!-- Producto 1: Margherita -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="pizzas">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 fw-bold">Popular</span>
          <img src="https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Margherita Especial" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Margherita Especial</h3>
              <span class="fs-5 fw-bold text-warning">$4.500</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Salsa de tomate San Marzano, fior di latte fresco, albahaca y aceite de oliva virgen extra.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50" data-bs-toggle="modal" data-bs-target="#modalProducto1">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Producto 2: Pepperoni Supreme -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="pizzas">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <img src="https://images.unsplash.com/photo-1628840042765-356cda07504e?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Pepperoni Supreme" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Pepperoni Supreme</h3>
              <span class="fs-5 fw-bold text-warning">$5.200</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Doble capa de pepperoni picante, mozzarella derretida y lluvia de orégano silvestre.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Producto 3: Cuatro Quesos -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="pizzas">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <img src="https://images.unsplash.com/photo-1573821663912-569905455b1c?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Cuatro Quesos" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Cuatro Quesos</h3>
              <span class="fs-5 fw-bold text-warning">$5.600</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Mezcla artesanal de mozzarella, gorgonzola inteso, provolone ahumado y parmesano.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Producto 4: Empanada de Carne a Cuchillo -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="empanadas">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <img src="https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Empanada de Carne" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Carne Cortada a Cuchillo</h3>
              <span class="fs-5 fw-bold text-warning">$900</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Receta tradicional de carne de res, cebolla verdeo, huevo duro y especias regionales.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Producto 5: Tiramisú Clásico -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="postres">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <img src="https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Tiramisú" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">Tiramisú Napolitano</h3>
              <span class="fs-5 fw-bold text-warning">$2.800</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Vainillas embebidas en café expresso con licor, crema de mascarpone y cacao puro.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Producto 6: Cerveza Artesanal -->
      <div class="col-lg-4 col-md-6 producto-item" data-categoria="bebidas">
        <div class="card bg-dark text-white h-100 border-secondary shadow position-relative">
          <img src="https://images.unsplash.com/photo-1608270586620-248524c67de9?auto=format&fit=crop&w=600&q=80" class="card-img-top object-fit-cover" alt="Cerveza Artesanal IPA" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h3 class="card-title h5 fw-bold mb-0">IPA Artesanal 500ml</h3>
              <span class="fs-5 fw-bold text-warning">$2.200</span>
            </div>
            <p class="card-text text-secondary small flex-grow-1">
              Cerveza tirada estilo India Pale Ale, de aroma cítrico y amargor equilibrado.
            </p>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-outline-light w-50">
                <i class="bi bi-info-circle me-1"></i> Detalle
              </button>
              <button class="btn btn-warning fw-bold text-dark w-50">
                <i class="bi bi-cart-plus me-1"></i> Agregar
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Modal de Detalle (Ejemplo para Producto 1) -->
<div class="modal fade" id="modalProducto1" tabindex="-1" aria-labelledby="modalProducto1Label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered text-white">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title fw-bold text-warning" id="modalProducto1Label">Margherita Especial</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <img src="https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?auto=format&fit=crop&w=600&q=80" class="img-fluid rounded mb-3 w-100 object-fit-cover" style="height: 250px;" alt="Margherita">
        <h6>Ingredientes:</h6>
        <p class="text-secondary small">Salsa San Marzano importada de Italia, mozzarella Fior di Latte, albahaca fresca de huerta, aceite de oliva virgen extra y masa madre fermentada por 48 hs.</p>
        <div class="mb-3">
          <label for="tamanoPizza" class="form-label text-warning small fw-bold">Tamaño:</label>
          <select class="form-select bg-black text-white border-secondary" id="tamanoPizza">
            <option selected>Individual (4 porciones) - $4.500</option>
            <option value="1">Grande (8 porciones) - $7.800</option>
            <option value="2">Familiar (12 porciones) - $10.500</option>
          </select>
        </div>
      </div>
      <div class="modal-footer border-secondary justify-content-between">
        <span class="fs-4 fw-bold text-warning">$4.500</span>
        <button type="button" class="btn btn-warning fw-bold text-dark px-4" data-bs-dismiss="modal">Confirmar Agregar</button>
      </div>
    </div>
  </div>
</div>