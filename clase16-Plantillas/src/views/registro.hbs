<section class="login-section">
  <div class="login-card">
    <div class="login-header">
      <div class="brand-badge">🍕</div>
      <h1>Pizzería Bella Napoli</h1>
      <p>Creá tu cuenta para realizar pedidos y acceder a promociones</p>
    </div>

    {{!-- Bloque para array de errores devuelto por express-validator (errors.array()) --}}
    {{#if errors}}
      <div class="alert-error" role="alert">
        {{#each errors}}
          <div>{{this.msg}}</div>
        {{/each}}
      </div>
    {{/if}}

    {{!-- Bloque opcional por si enviás un único mensaje de error (ej. email ya registrado) --}}
    {{#if error}}
      <div class="alert-error" role="alert">
        {{error}}
      </div>
    {{/if}}

    <form action="/api/users/register" method="POST" class="login-form">
      <div class="form-group">
        <label for="nombre">Nombre completo</label>
        <input
          type="text"
          id="nombre"
          name="nombre"
          placeholder="Ingresá tu nombre"
          value="{{nombre}}"
          minlength="3"
          maxlength="30"
          required
          autocomplete="name"
        />
      </div>

      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="ejemplo@bellanapoli.com"
          value="{{email}}"
          required
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="••••••••"
          minlength="6"
          maxlength="12"
          required
          autocomplete="new-password"
        />
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Registrarse</button>
        <button type="reset" class="btn btn-secondary">Borrar</button>
      </div>
    </form>

    <div class="login-header">
      <p>
        ¿Ya tenés una cuenta?
        <a href="/login">Iniciá sesión acá</a>
      </p>
    </div>
  </div>
</section>